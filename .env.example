PORT=3000

# ===== AUDD API TOKEN =====
# Dapatkan token dari https://audd.io/
# Support multiple tokens dengan format: AUDD_TOKEN_1, AUDD_TOKEN_2, dst
# Atau single string dengan format koma: AUDD_TOKEN=token1,token2,token3
AUDD_TOKEN=

# ===== OPENAI API KEY =====
# Dapatkan dari https://platform.openai.com/api-keys
# Digunakan untuk normalisasi & validasi hasil recognition
# Jika kosong, sistem akan tetap bekerja tanpa OpenAI (tanpa normalisasi)
OPENAI_API_KEY=

# ===== PIN CONFIGURATION =====
# PIN untuk Mode Keluarga (unlimited searches + clip access)
FAMILY_PIN=01092007

# PIN untuk Mode Admin (unlimited searches + clip access + admin controls)
ADMIN_PIN=Irman

# ===== QUOTA CONFIGURATION =====
# Batas pencarian untuk user reguler
MAX_LIMIT=20

# Durasi cooldown dalam jam
COOLDOWN_HOURS=20
