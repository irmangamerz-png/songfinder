<!DOCTYPE html>
<html lang="id" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SongFinder Pro - Audio Fingerprint Matcher</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes rgbGlow {
            0% { filter: hue-rotate(0deg); }
            50% { filter: hue-rotate(180deg); }
            100% { filter: hue-rotate(360deg); }
        }

        .rgb-bg-effect {
            position: fixed;
            inset: -50px;
            z-index: -1;
            background: linear-gradient(45deg, #ff0055, #7000ff, #00ffff, #00ff66, #ff0055);
            background-size: 400% 400%;
            animation: rgbGlow 12s ease infinite;
            pointer-events: none;
            transition: opacity 0.5s ease;
        }

        .theme-dark {
            background-color: #030712;
            color: #f8fafc;
        }
        .theme-dark .app-card {
            background-color: #0f172a;
            border-color: #1e293b;
        }
        .theme-dark .app-input {
            background-color: #020617;
            border-color: #1e293b;
            color: #f8fafc;
        }

        .theme-light {
            background-color: #f8fafc;
            color: #0f172a;
        }
        .theme-light .app-card {
            background-color: #ffffff;
            border-color: #e2e8f0;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .theme-light .app-input {
            background-color: #f1f5f9;
            border-color: #cbd5e1;
            color: #0f172a;
        }

        #sfAdminPanel {
          display: none;
          position: fixed;
          inset: 0;
          z-index: 99999;
          background: rgba(0,0,0,0.75);
          padding: 18px;
          box-sizing: border-box;
          overflow: auto;
          align-items: center;
          justify-content: center;
        }
        #sfAdminPanel.sf-open { display: flex; }
        .sf-admin-card {
          width: min(480px, 100%);
          max-height: 90vh;
          overflow: auto;
          border-radius: 16px;
          padding: 20px;
          background: #1e1b4b;
          border: 1px solid rgba(168, 85, 247, 0.3);
          color: #f8fafc;
          box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        }
        .sf-admin-stat {
          padding: 12px;
          margin: 10px 0;
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.05);
          font-size: 13px;
        }
    </style>
</head>
<body id="bodyRoot" class="theme-dark min-h-screen flex flex-col items-center justify-center p-4 relative transition-colors duration-500">

    <div class="rgb-bg-effect" id="rgbBg"></div>

    <button onclick="openAdminPanel()" class="absolute top-4 right-4 app-card border hover:border-purple-500 text-slate-400 hover:text-purple-400 p-2.5 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 shadow-md z-10" title="Login Admin">
        <i class="fa-solid fa-lock text-purple-400"></i> Admin
    </button>

    <button onclick="toggleThemeManual()" id="themeToggleBtn" class="absolute top-4 left-4 app-card border hover:border-purple-500 p-2.5 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 shadow-md z-10" title="Ubah Tema Manual">
        <i id="themeIcon" class="fa-solid fa-moon text-purple-400"></i> <span id="sensorText">Mode Gelap RGB</span>
    </button>

    <div class="w-full max-w-md app-card border rounded-2xl shadow-xl p-6 mt-12">
        <h1 class="text-xl font-bold text-center mb-6 text-purple-400">SongFinder Pro <span class="text-xs px-2 py-0.5 bg-purple-500/20 text-purple-300 rounded-full border border-purple-500/30">Omni-Match Engine</span></h1>

        <div class="flex bg-slate-900/40 p-1 rounded-xl mb-6 border border-slate-700/30">
            <button id="tabLink" onclick="switchTab('link')" class="flex-1 py-2 text-sm font-medium rounded-lg bg-purple-600 text-white transition">Link Media</button>
            <button id="tabFile" onclick="switchTab('file')" class="flex-1 py-2 text-sm font-medium rounded-lg text-slate-400 transition">Upload File</button>
        </div>

        <div id="sectionLink" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold opacity-80 mb-2">Masukkan Link TikTok</label>
                <div class="relative">
                    <input type="text" id="urlInput" placeholder="Masukkan link TikTok di sini..." class="w-full app-input border rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-500 pr-10">
                    <button onclick="clearInput()" class="absolute right-3 top-3.5 opacity-50 hover:opacity-100">✕</button>
                </div>
                <p class="text-[10px] opacity-60 mt-1.5">Mendukung pencocokan sidik jari audio langsung.</p>
            </div>
            <p id="limitNoticeText" class="text-[11px] text-amber-400/90 font-medium bg-amber-500/10 p-2.5 rounded-xl border border-amber-500/20">
                ⚠️ Sisa kuota penggunaan reguler: 20/20 link. Jeda tunggu 20 jam aktif jika habis.
            </p>
        </div>

        <div id="sectionFile" class="space-y-4 hidden">
            <div>
                <label class="block text-xs font-semibold opacity-80 mb-2">Pilih File Video/Audio dari HP</label>
                <input type="file" id="fileInput" accept="video/*,audio/*" class="w-full app-input border rounded-xl p-2 text-sm opacity-80 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-purple-600 file:text-white hover:file:bg-purple-700">
            </div>
        </div>

        <button onclick="processSearch()" id="submitBtn" class="w-full mt-6 bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded-xl transition shadow-lg shadow-purple-900/40">
            Kenali Audio Otomatis
        </button>

        <div id="resultContainer" class="mt-6 hidden p-4 app-input border rounded-xl text-sm space-y-4">
            <div class="flex items-center gap-3">
                <img id="albumArt" src="" alt="Thumbnail / Cover" class="w-16 h-16 rounded-xl object-cover border border-slate-700/40 shadow-md">
                <div class="overflow-hidden">
                    <p id="songTitle" class="font-bold text-purple-400 truncate">Judul Lagu</p>
                    <p id="songArtist" class="text-xs opacity-75 truncate">Artis</p>
                    <p id="songAlbum" class="text-[10px] opacity-50 truncate">-</p>
                </div>
            </div>

            <div id="directAudioWrapper" class="space-y-1.5 pt-1">
                <p class="text-[11px] font-semibold text-emerald-400"><i class="fa-solid fa-volume-high mr-1"></i> Putar Berkas Audio:</p>
                <audio id="directAudioPlayer" controls class="w-full h-9 rounded-lg"></audio>
            </div>

            <div class="grid grid-cols-1 gap-2 pt-1">
                <a id="youtubeLink" href="#" target="_blank" class="py-2.5 px-3 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-red-400 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition">
                    <i class="fa-brands fa-youtube text-sm"></i> Cari Lagu Ini di YouTube
                </a>
            </div>
            <a id="tiktokDirectLink" href="#" target="_blank" class="w-full hidden py-2.5 px-3 bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 text-cyan-400 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition">
                <i class="fa-brands fa-tiktok text-sm"></i> Buka Video Asli
            </a>
        </div>
    </div>

    <div id="sfAdminPanel">
      <div class="sf-admin-card">
        <h2 style="margin-top:0" class="text-purple-400 font-bold text-base mb-1">🔐 Panel Admin Eksklusif</h2>
        <p class="text-xs text-slate-400 mb-4">Kontrol sistem pembatasan kuota dan jeda tunggu.</p>

        <div class="sf-admin-stat space-y-1">
          <div><b>Status Akses:</b> <span id="sfAdminStatusText" class="text-emerald-400">Admin Aktif (Bebas tanpa jeda)</span></div>
          <div><b>Penggunaan Tersimpan:</b> <span id="sfAdminCount">0 / 1000</span></div>
        </div>

        <div class="flex flex-col gap-2 mt-4">
          <button type="button" id="sfAdminResetBtn" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-medium transition">🔄 Reset Kuota & Cooldown</button>
          <button type="button" id="sfAdminLogoutBtn" class="w-full py-2.5 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-400 rounded-xl text-xs font-medium transition">🚪 Logout Admin (Cek PIN Lagi)</button>
          <button type="button" id="sfAdminCloseBtn" class="w-full py-2.5 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-medium transition">✕ Tutup</button>
        </div>
      </div>
    </div>

    <script>
        const BACKEND_API_URL = 'https://your-backend-server.com/api/recognize';

        let currentMode = 'link';
        const MAX_USER_LIMIT = 20;
        const COOLDOWN_HOURS = 20;
        
        const SF_ADMIN_MODE = 'SF_ADMIN_MODE';
        const SF_FAMILY_MODE = 'SF_FAMILY_MODE';
        const SF_ADMIN_PIN = '01092007';
        const FAMILY_CODE = 'Irman';
        let globalCleanTikTokUrl = '';

        function applyTheme(isDark) {
            const bodyRoot = document.getElementById('bodyRoot');
            const sensorText = document.getElementById('sensorText');
            const themeIcon = document.getElementById('themeIcon');
            const rgbBg = document.getElementById('rgbBg');

            if (isDark) {
                bodyRoot.className = "theme-dark min-h-screen flex flex-col items-center justify-center p-4 relative transition-colors duration-500";
                rgbBg.style.opacity = '0.25';
                sensorText.textContent = "Mode Gelap RGB";
                themeIcon.className = "fa-solid fa-moon text-purple-400";
                localStorage.setItem('SF_USER_THEME', 'dark');
            } else {
                bodyRoot.className = "theme-light min-h-screen flex flex-col items-center justify-center p-4 relative transition-colors duration-500";
                rgbBg.style.opacity = '0.07';
                sensorText.textContent = "Mode Terang";
                themeIcon.className = "fa-solid fa-sun text-amber-400";
                localStorage.setItem('SF_USER_THEME', 'light');
            }
        }

        function toggleThemeManual() {
            const bodyRoot = document.getElementById('bodyRoot');
            const isCurrentlyDark = bodyRoot.classList.contains('theme-dark');
            applyTheme(!isCurrentlyDark);
        }

        function initLightingSensor() {
            const savedTheme = localStorage.getItem('SF_USER_THEME');
            if (savedTheme) {
                applyTheme(savedTheme === 'dark');
                return;
            }
            const currentHour = new Date().getHours();
            applyTheme(currentHour >= 18 || currentHour < 6);
        }

        document.addEventListener('DOMContentLoaded', () => {
            initLightingSensor();
            updateLimitNoticeUI();
        });

        function isAdminActive() {
            try { return localStorage.getItem(SF_ADMIN_MODE) === '1'; } catch (e) { return false; }
        }

        function isFamilyActive() {
            try { return localStorage.getItem(SF_FAMILY_MODE) === '1'; } catch (e) { return false; }
        }

        function checkAndUpdateQueueLimit() {
            if (isAdminActive() || isFamilyActive()) return { allowed: true };
            try {
                const now = Date.now();
                let usageCount = parseInt(localStorage.getItem('SF_USAGE_COUNT') || '0', 10);
                let cooldownEnd = parseInt(localStorage.getItem('SF_COOLDOWN_END') || '0', 10);

                if (cooldownEnd && now < cooldownEnd) {
                    const remainingHours = Math.ceil((cooldownEnd - now) / (1000 * 60 * 60));
                    return { allowed: false, message: `Batas kuota habis. Harap tunggu sekitar ${remainingHours} jam lagi.` };
                }
                if (cooldownEnd && now >= cooldownEnd) {
                    usageCount = 0;
                    localStorage.setItem('SF_USAGE_COUNT', '0');
                    localStorage.removeItem('SF_COOLDOWN_END');
                }
                if (usageCount >= MAX_USER_LIMIT) {
                    const newCooldownEnd = now + (COOLDOWN_HOURS * 60 * 60 * 1000);
                    localStorage.setItem('SF_COOLDOWN_END', newCooldownEnd.toString());
                    return { allowed: false, message: `Batas ${MAX_USER_LIMIT} link tercapai. Jeda ${COOLDOWN_HOURS} jam aktif.` };
                }
                return { allowed: true, remaining: MAX_USER_LIMIT - usageCount };
            } catch (e) { return { allowed: true }; }
        }

        function recordUsage() {
            if (isAdminActive() || isFamilyActive()) return;
            try {
                let usageCount = parseInt(localStorage.getItem('SF_USAGE_COUNT') || '0', 10) + 1;
                localStorage.setItem('SF_USAGE_COUNT', usageCount.toString());
                if (usageCount >= MAX_USER_LIMIT) {
                    const cooldownEnd = Date.now() + (COOLDOWN_HOURS * 60 * 60 * 1000);
                    localStorage.setItem('SF_COOLDOWN_END', cooldownEnd.toString());
                }
                updateLimitNoticeUI();
            } catch (e) {}
        }

        function updateLimitNoticeUI() {
            const noticeEl = document.getElementById('limitNoticeText');
            if (!noticeEl) return;
            if (isAdminActive()) {
                noticeEl.innerHTML = `🛡️ <b>Admin Mode Aktif:</b> Akses tanpa batas & tanpa jeda tunggu.`;
                noticeEl.className = `text-[11px] text-emerald-400 font-medium bg-emerald-500/10 p-2.5 rounded-xl border border-emerald-500/20`;
                return;
            }
            if (isFamilyActive()) {
                noticeEl.innerHTML = `🏠 <b>Family Mode (Irman):</b> Akses Family aktif tanpa batas kuota.`;
                noticeEl.className = `text-[11px] text-purple-400 font-medium bg-purple-500/10 p-2.5 rounded-xl border border-purple-500/20`;
                return;
            }
            const check = checkAndUpdateQueueLimit();
            if (!check.allowed) {
                noticeEl.innerHTML = `⚠️ ${check.message}`;
                noticeEl.className = `text-[11px] text-rose-400 font-medium bg-rose-500/10 p-2.5 rounded-xl border border-rose-500/20`;
            } else {
                const remaining = check.remaining !== undefined ? check.remaining : MAX_USER_LIMIT;
                noticeEl.innerHTML = `⚠️ Sisa kuota reguler: ${remaining}/${MAX_USER_LIMIT} link. Jeda ${COOLDOWN_HOURS} jam aktif habis.`;
                noticeEl.className = `text-[11px] text-amber-400/90 font-medium bg-amber-500/10 p-2.5 rounded-xl border border-amber-500/20`;
            }
        }

        function switchTab(mode) {
            currentMode = mode;
            const tabLink = document.getElementById('tabLink');
            const tabFile = document.getElementById('tabFile');
            const sectionLink = document.getElementById('sectionLink');
            const sectionFile = document.getElementById('sectionFile');

            if (mode === 'link') {
                tabLink.className = "flex-1 py-2 text-sm font-medium rounded-lg bg-purple-600 text-white transition";
                tabFile.className = "flex-1 py-2 text-sm font-medium rounded-lg text-slate-400 transition";
                sectionLink.classList.remove('hidden');
                sectionFile.classList.add('hidden');
            } else {
                tabFile.className = "flex-1 py-2 text-sm font-medium rounded-lg bg-purple-600 text-white transition";
                tabLink.className = "flex-1 py-2 text-sm font-medium rounded-lg text-slate-400 transition";
                sectionFile.classList.remove('hidden');
                sectionLink.classList.add('hidden');
            }
        }

        function clearInput() { document.getElementById('urlInput').value = ''; }

        function cleanAndExtractUrl(text) {
            if (!text) return '';
            const match = text.match(/https?:\/\/[^\s]+/);
            return match ? match[0].trim() : text.trim();
        }

        function isValidUrl(string) {
            try {
                const url = new URL(string);
                return url.protocol === "http:" || url.protocol === "https:";
            } catch (_) {
                return false;
            }
        }

        async function fetchWithTimeout(resource, options = {}, timeout = 25000) {
            const controller = new AbortController();
            const id = setTimeout(() => controller.abort(), timeout);
            try {
                const response = await fetch(resource, { ...options, signal: controller.signal });
                clearTimeout(id);
                return response;
            } catch (error) {
                clearTimeout(id);
                throw error;
            }
        }

        async function sliceAudioBlobToSegments(audioBlob) {
            try {
                const arrayBuffer = await audioBlob.arrayBuffer();
                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtxClass) return [audioBlob];
                
                const audioCtx = new AudioCtxClass();
                const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
                
                const duration = audioBuffer.duration;
                const sampleRate = audioBuffer.sampleRate;
                const numberOfChannels = audioBuffer.numberOfChannels;

                const segmentLengthSec = Math.min(12, duration);
                const startOffsets = [0];
                if (duration > 15) {
                    startOffsets.push(duration * 0.25);
                    startOffsets.push(duration * 0.45);
                    startOffsets.push(duration * 0.65);
                }

                const segmentBlobs = [];
                for (let startSec of startOffsets) {
                    if (startSec + segmentLengthSec > duration && duration > segmentLengthSec) {
                        startSec = Math.max(0, duration - segmentLengthSec);
                    }
                    const startSample = Math.floor(startSec * sampleRate);
                    const endSample = Math.min(Math.floor((startSec + segmentLengthSec) * sampleRate), audioBuffer.length);
                    const frameCount = endSample - startSample;

                    if (frameCount <= 0) continue;

                    const segmentBuffer = audioCtx.createBuffer(numberOfChannels, frameCount, sampleRate);
                    for (let ch = 0; ch < numberOfChannels; ch++) {
                        const channelData = audioBuffer.getChannelData(ch);
                        segmentBuffer.getChannelData(ch).set(channelData.subarray(startSample, endSample));
                    }

                    const wavBlob = audioBufferToWavBlob(segmentBuffer);
                    if (wavBlob.size > 1000) {
                        segmentBlobs.push(wavBlob);
                    }
                }

                if (audioCtx.state !== 'closed') {
                    await audioCtx.close().catch(() => {});
                }
                return segmentBlobs.length > 0 ? segmentBlobs : [audioBlob];
            } catch (e) {
                return [audioBlob];
            }
        }

        function audioBufferToWavBlob(buffer) {
            try {
                const numOfChan = buffer.numberOfChannels;
                const length = buffer.length * numOfChan * 2 + 44;
                const out = new DataView(new ArrayBuffer(length));
                let channels = [];
                let sampleRate = buffer.sampleRate;
                let offset = 0;
                let pos = 0;

                function writeString(str) {
                    for (let i = 0; i < str.length; i++) {
                        out.setUint8(pos++, str.charCodeAt(i));
                    }
                }

                function setUint16(data) {
                    out.setUint16(pos, data, true);
                    pos += 2;
                }

                function setUint32(data) {
                    out.setUint32(pos, data, true);
                    pos += 4;
                }

                writeString('RIFF');
                setUint32(length - 8);
                writeString('WAVE');
                writeString('fmt ');
                setUint32(16);
                setUint16(1);
                setUint16(numOfChan);
                setUint32(sampleRate);
                setUint32(sampleRate * 2 * numOfChan);
                setUint16(numOfChan * 2);
                setUint16(16);
                writeString('data');
                setUint32(length - pos - 4);

                for (let i = 0; i < buffer.numberOfChannels; i++) {
                    channels.push(buffer.getChannelData(i));
                }

                while (pos < length) {
                    for (let i = 0; i < numOfChan; i++) {
                        let sample = Math.max(-1, Math.min(1, channels[i][offset]));
                        sample = (sample < 0 ? sample * 32768 : sample * 32767);
                        out.setInt16(pos, sample, true);
                        pos += 2;
                    }
                    offset++;
                }

                return new Blob([out.buffer], { type: 'audio/wav' });
            } catch (e) {
                return new Blob();
            }
        }

        async function sendAudioToBackend(audioBlob) {
            const formData = new FormData();
            formData.append('file', audioBlob, 'segment.wav');

            const res = await fetchWithTimeout(BACKEND_API_URL, {
                method: 'POST',
                body: formData
            }, 20000);

            const json = await res.json();
            return json;
        }

        async function performMultiAttemptRecognition(audioSource, isUrl = true) {
            let candidates = [];
            let attempts = [];

            if (isUrl) {
                attempts.push({ type: 'url', val: audioSource });
                try {
                    const fetchRes = await fetchWithTimeout(audioSource, {}, 12000);
                    if (fetchRes.ok) {
                        const blobData = await fetchRes.blob();
                        const segments = await sliceAudioBlobToSegments(blobData);
                        segments.forEach(seg => {
                            attempts.push({ type: 'file', val: seg });
                        });
                    }
                } catch (err) {}
            } else {
                try {
                    let segments = await sliceAudioBlobToSegments(audioSource);
                    segments.forEach(seg => attempts.push({ type: 'file', val: seg }));
                } catch (e) {
                    attempts.push({ type: 'file', val: audioSource });
                }
            }

            for (let attempt of attempts) {
                try {
                    let apiRes;
                    if (attempt.type === 'url') {
                        const formData = new URLSearchParams();
                        formData.append('url', attempt.val);
                        const res = await fetchWithTimeout(BACKEND_API_URL, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: formData.toString()
                        }, 15000);
                        apiRes = await res.json();
                    } else {
                        apiRes = await sendAudioToBackend(attempt.val);
                    }

                    if (apiRes && apiRes.success && apiRes.result && apiRes.result.title) {
                        candidates.push(apiRes.result);
                    }
                } catch (e) {}
            }

            let bestCandidate = null;
            if (candidates.length > 0) {
                let scoreMap = {};
                for (let c of candidates) {
                    let key = `${(c.title || '').toLowerCase().trim()} - ${(c.artist || '').toLowerCase().trim()}`;
                    if (!scoreMap[key]) {
                        scoreMap[key] = { count: 0, data: c };
                    }
                    scoreMap[key].count++;
                }

                let maxScore = -1;
                for (let key in scoreMap) {
                    if (scoreMap[key].count > maxScore) {
                        maxScore = scoreMap[key].count;
                        bestCandidate = scoreMap[key].data;
                    }
                }
            }

            if (bestCandidate) {
                return { success: true, result: bestCandidate };
            }

            return { success: false };
        }

        async function processSearch() {
            const queueCheck = checkAndUpdateQueueLimit();
            if (!queueCheck.allowed) { 
                alert(queueCheck.message); 
                return; 
            }

            const btn = document.getElementById('submitBtn');
            const resultContainer = document.getElementById('resultContainer');
            const directAudioPlayer = document.getElementById('directAudioPlayer');
            const directAudioWrapper = document.getElementById('directAudioWrapper');
            const tiktokDirectLink = document.getElementById('tiktokDirectLink');

            resultContainer.classList.add('hidden');
            directAudioPlayer.pause();
            directAudioPlayer.src = '';
            directAudioWrapper.classList.add('hidden');
            tiktokDirectLink.classList.add('hidden');
            globalCleanTikTokUrl = '';

            btn.disabled = true;

            try {
                let targetAudioUrl = '';
                let videoCoverUrl = '';
                let rawFileObj = null;
                let cleanUrl = '';

                if (currentMode === 'link') {
                    let originalInput = document.getElementById('urlInput').value;
                    if (!originalInput) { 
                        alert('Masukkan link terlebih dahulu!'); 
                        return; 
                    }

                    cleanUrl = cleanAndExtractUrl(originalInput);
                    if (!isValidUrl(cleanUrl)) {
                        alert('URL yang dimasukkan tidak valid. Harap masukkan URL yang benar.');
                        return;
                    }

                    globalCleanTikTokUrl = cleanUrl;
                    document.getElementById('urlInput').value = cleanUrl;
                    btn.innerText = "Mengekstrak Audio...";

                    if (cleanUrl.includes('tiktok.com') || cleanUrl.includes('vm.tiktok.com')) {
                        const tikRes = await fetchWithTimeout(`https://www.tikwm.com/api/?url=${encodeURIComponent(cleanUrl)}`, {}, 15000);
                        const tikData = await tikRes.json();
                        
                        if (tikData && tikData.data) {
                            targetAudioUrl = tikData.data.music || tikData.data.play || tikData.data.music_info?.play || '';
                            videoCoverUrl = tikData.data.cover || tikData.data.origin_cover || '';
                        }
                    } else if (cleanUrl.includes('youtube.com') || cleanUrl.includes('youtu.be')) {
                        targetAudioUrl = cleanUrl;
                        videoCoverUrl = 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&auto=format&fit=crop&q=80';
                    }

                    if (!targetAudioUrl || !isValidUrl(targetAudioUrl)) {
                        throw new Error('Gagal mengekstrak audio dari link tersebut. Pastikan link aktif atau publik.');
                    }

                } else {
                    const fileInput = document.getElementById('fileInput');
                    if (!fileInput.files || fileInput.files.length === 0) {
                        alert('Silakan pilih file video atau audio terlebih dahulu!');
                        return;
                    }

                    const selectedFile = fileInput.files[0];
                    btn.innerText = "Memuat File Lokal...";
                    
                    targetAudioUrl = URL.createObjectURL(selectedFile);
                    rawFileObj = selectedFile;
                    videoCoverUrl = 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&auto=format&fit=crop&q=80';
                }

                if (targetAudioUrl && currentMode !== 'link') {
                    directAudioPlayer.src = targetAudioUrl;
                    directAudioWrapper.classList.remove('hidden');
                }

                btn.innerText = "Memindai Sidik Jari Audio...";
                
                let recognitionRes;
                if (currentMode === 'link') {
                    recognitionRes = await performMultiAttemptRecognition(targetAudioUrl, true);
                } else {
                    recognitionRes = await performMultiAttemptRecognition(rawFileObj, false);
                }

                recordUsage();

                if (recognitionRes && recognitionRes.success && recognitionRes.result) {
                    const song = recognitionRes.result;
                    displayResult(song.title, song.artist, `Ditemukan: ${song.album || 'Audio Teridentifikasi'}`, videoCoverUrl, true);
                } else {
                    displayResult("Lagu Belum Terdeteksi", "Tidak ditemukan di database pengenalan audio", "Audio valid berhasil dimuat", videoCoverUrl, false);
                }

            } catch (err) {
                alert(err.message || 'Terjadi kesalahan pada sistem saat memproses audio.');
            } finally {
                btn.disabled = false;
                btn.innerText = "Kenali Audio Otomatis";
            }
        }

        function displayResult(title, artist, albumInfo, cover, isFound) {
            document.getElementById('songTitle').textContent = title;
            document.getElementById('songArtist').textContent = artist;
            document.getElementById('songAlbum').textContent = albumInfo;
            document.getElementById('albumArt').src = cover || 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&auto=format&fit=crop&q=80';

            const youtubeLink = document.getElementById('youtubeLink');
            let queryStr = encodeURIComponent(`${title} ${artist}`);
            youtubeLink.href = `https://www.youtube.com/results?search_query=${queryStr}`;
            youtubeLink.innerHTML = `<i class="fa-brands fa-youtube text-sm"></i> Cari Lagu Ini di YouTube`;

            const tiktokDirectLink = document.getElementById('tiktokDirectLink');
            if (globalCleanTikTokUrl) {
                tiktokDirectLink.href = globalCleanTikTokUrl;
                tiktokDirectLink.classList.remove('hidden');
            } else {
                tiktokDirectLink.classList.add('hidden');
            }

            document.getElementById('resultContainer').classList.remove('hidden');
        }

        const sfAdminPanel = document.getElementById('sfAdminPanel');
        const sfAdminCount = document.getElementById('sfAdminCount');
        const sfAdminResetBtn = document.getElementById('sfAdminResetBtn');
        const sfAdminLogoutBtn = document.getElementById('sfAdminLogoutBtn');
        const sfAdminCloseBtn = document.getElementById('sfAdminCloseBtn');

        function openAdminPanel() {
            if (!isAdminActive()) {
                const inputVal = prompt('Masukkan PIN Admin atau Kode Keluarga:');
                if (inputVal === null) return;

                if (inputVal.trim() === FAMILY_CODE) {
                    localStorage.setItem(SF_FAMILY_MODE, '1');
                    localStorage.removeItem(SF_ADMIN_MODE);
                    alert('Berhasil masuk ke Family Mode (Irman).');
                    updateLimitNoticeUI();
                    return;
                }

                if (inputVal !== SF_ADMIN_PIN) {
                    alert('PIN atau Kode salah.');
                    return;
                }
                localStorage.setItem(SF_ADMIN_MODE, '1');
                localStorage.removeItem(SF_FAMILY_MODE);
                localStorage.removeItem('SF_COOLDOWN_END');
            }

            if (isFamilyActive()) {
                alert('Anda masuk sebagai Family (Irman). Panel Admin khusus Admin dikunci.');
                return;
            }

            sfAdminPanel.classList.add('sf-open');
            if (sfAdminCount) {
                const currentCount = localStorage.getItem('SF_USAGE_COUNT') || '0';
                sfAdminCount.textContent = `${currentCount} / 1000 (Unlimited Mode)`;
            }
            updateLimitNoticeUI();
        }

        sfAdminCloseBtn?.addEventListener('click', () => { sfAdminPanel.classList.remove('sf-open'); });
        sfAdminLogoutBtn?.addEventListener('click', () => {
            localStorage.removeItem(SF_ADMIN_MODE);
            localStorage.removeItem(SF_FAMILY_MODE);
            sfAdminPanel.classList.remove('sf-open');
            updateLimitNoticeUI();
            alert('Berhasil logout sesi.');
        });
        sfAdminResetBtn?.addEventListener('click', () => {
            localStorage.removeItem('SF_USAGE_COUNT');
            localStorage.removeItem('SF_COOLDOWN_END');
            if (sfAdminCount) sfAdminCount.textContent = '0 / 1000 (Unlimited Music Database)';
            updateLimitNoticeUI();
            alert('Database kustom berhasil di-reset!');
        });
    </script>
</body>
</html>
